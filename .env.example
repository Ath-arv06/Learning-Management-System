# ==============================================================================
# Opt-Out University LMS - Environment Variables Template
# Copy this file to .env and configure your secrets. Never commit .env to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL 8.4)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=optout_lms_db
DB_USER=lms_app
DB_PASSWORD=LmsSecretPass2026!

# ------------------------------------------------------------------------------
# 2. APPLICATION & SERVER
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_BASE_URL=http://localhost:8080
CLIENT_BASE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate a secure 512-bit secret using: openssl rand -base64 64
JWT_SECRET=c2VjdXJlX2xvbmdfcmFuZG9tX2tleV9mb3Jfb3B0b3V0X2xtc18yMDI2X3VuaXZlcnNpdHlfcGxhdGZvcm1fc2VjcmV0IQ==
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH2 (GOOGLE SIGN-IN)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Retrieve from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 6. STORAGE & FILE UPLOADS
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=250

# ------------------------------------------------------------------------------
# 7. EMAIL CONFIGURATION (SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@university.edu
MAIL_PASSWORD=your-app-password
MAIL_FROM=no-reply@optout-lms.edu
