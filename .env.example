# ============================================================
# Apex College LMS — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# ── Database ──────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/lms_db?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=lms_user
DB_PASSWORD=LmsDevPass2024!

# ── File storage ──────────────────────────────────────────────
UPLOAD_BASE_PATH=./uploads

# ── Email (set MAIL_* vars and EMAIL_ENABLED=true for real email)
EMAIL_ENABLED=false
EMAIL_FROM=noreply@apexcollege.edu
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ── Google OAuth (get from Google Cloud Console > Credentials)
# Leave as PLACEHOLDER until you have real credentials.
# See README section 13 for setup instructions.
GOOGLE_CLIENT_ID=PLACEHOLDER_SET_IN_ENV
GOOGLE_CLIENT_SECRET=PLACEHOLDER_SET_IN_ENV

# ── AI Provider ───────────────────────────────────────────────
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ── Live Class Integration ────────────────────────────────────
LIVE_CLASS_PROVIDER=none
ZOOM_API_KEY=
ZOOM_API_SECRET=

# ── CORS (frontend origin) ────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── S3-compatible storage (production only) ───────────────────
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
